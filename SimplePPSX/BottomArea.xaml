<UserControl
	x:Class="SimplePPSX.BottomArea"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:spx="clr-namespace:SimplePPSX"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:ei="http://schemas.microsoft.com/xaml/behaviors"
	Height="56">
    <!-- Center toolbar: pointer / pen / eraser / collapse ... exit, all on ONE plate.

     Three buttons plus a collapse key and the exit cross, in a single row with a
     single backdrop.

     It used to be two plates with a 12px transparent gap between them - the tool
     group on one, the exit cross on the other - and that is gone: the gap showed
     the slide through the middle of the toolbar, and each plate was its own box to
     keep aligned. One strip, one plate, one set of columns.

     WHY THE PLATE LIVES INSIDE THE STRIP (this is the fix for the white rim)
     ========================================================================
     The backdrop Rectangle used to be a sibling of the button strip, stretched
     over the whole grid cell. The cell is as tall as the UserControl (56) while
     the strip is 54, so the plate stuck out 1px above and below the buttons -
     and the buttons are Transparent, so where a button paints its own background
     (the selected tool's accent plate, or the hover tint) that extra pixel read
     as a white rim around it, 2px in all: one above, one below.

     The plate is now the FIRST child of the strip, stretched, so it is laid out
     in exactly the same box the buttons are. The strip's own height tiers
     (38 / 54 / 90) then size both together and there is nothing left over to
     rim. The strip's Margin is 0 in every tier for the same reason: a margin
     would open a gap again, only around the outside this time.

     Icon note: every toolbar icon is a glyph from Material Symbols Sharp, shipped
     with the app in Fonts and named by the Font.MaterialSymbolsSharp resource
     in App.xaml. The glyphs fill from the button's Foreground, so they follow
     the Accent style of the selected state for free. The full mapping is at
     the top of Style_\ToolbarStyle.xaml. -->

    <UserControl.Resources>
        <!-- Pen colours: the ink palette PowerPoint offers, laid out as a grid.
		     Shown as one swatch per entry, so this list and the flyout stay in sync. -->
        <Style x:Key="Style.ToolbarColorSwatch" TargetType="{x:Type RadioButton}" />

        <!--
     The tool icons: three glyphs from Material Symbols Sharp, named by
     the Font.MaterialSymbolsSharp resource in App.xaml and mapped at the
     top of Style_\ToolbarStyle.xaml.

     The pointer is near_me (U+E569), the pen is edit (U+F097) and the
     eraser is ink_eraser (U+E6D0). The eraser used to be two hand-drawn
     Paths taking turns on the checked state, because MDL2 had no eraser
     glyph that read right at this size; one glyph covers both states now.
     The pointer used to be a hand-drawn arrow for the same reason.

     Every glyph fills from the button''s Foreground, so the selected state
     recolours it like the rest of the toolbar. The tier storyboards size
     them through FontSize, exactly like the collapse and exit keys.
-->

    </UserControl.Resources>

    <!-- VerticalAlignment="Bottom" is what pins the bar to the screen edge.

         The UserControl keeps Height="56" as its layout slot so the toolbar row
         never reflows when the bar changes tier or folds, but the bar itself is
         now as tall as it actually needs to be (the strip's height, 38 / 54 / 90).
         A bottom alignment is therefore the only thing that stops the leftover
         space from opening up ABOVE the bar, where it would be an invisible
         click-blocking band in front of the slide. -->
    <Grid x:Name="RootGrid" Background="Transparent" VerticalAlignment="Bottom">
        <UIElement.RenderTransform>
            <TranslateTransform Y="0" />
        </UIElement.RenderTransform>

        <!--
		  Height tiers.

		  Each tier sets the strip's height, the folded bar's height (exactly half
		  of it), the icon sizes and nothing else. RootGrid has no height of its
		  own any more - it takes the strip's - and the strip has no margin, so
		  plate, strip and buttons are one box with no remainder around them.

		  The plate used to be sized from the grid cell instead (40 / 56 / 92)
		  while the strip was 2px smaller inside it, which is where the white rim
		  around a button came from; see the note at the top of the file.

		  Adaptive1440 states its values explicitly rather than being empty. It
		  used to be empty, which meant switching INTO this tier from another one
		  left the previous tier's numbers in place - the visual states only write,
		  they never restore.
		-->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="Adaptive0">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ToolButtonStrip" Storyboard.TargetProperty="(FrameworkElement.Height)">
                            <EasingDoubleKeyFrame KeyTime="0" Value="38" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CollapsedBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                            <EasingDoubleKeyFrame KeyTime="0" Value="19" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="14" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PenIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="14" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EraserIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="14" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CollapseIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="14" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="14" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExitIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="14" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Adaptive1440">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ToolButtonStrip" Storyboard.TargetProperty="(FrameworkElement.Height)">
                            <EasingDoubleKeyFrame KeyTime="0" Value="54" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CollapsedBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                            <EasingDoubleKeyFrame KeyTime="0" Value="27" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="18" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PenIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="18" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EraserIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="18" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CollapseIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="18" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="18" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExitIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="18" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Adaptive3800">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ToolButtonStrip" Storyboard.TargetProperty="(FrameworkElement.Height)">
                            <EasingDoubleKeyFrame KeyTime="0" Value="90" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CollapsedBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                            <EasingDoubleKeyFrame KeyTime="0" Value="45" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="30" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PenIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="30" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EraserIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="30" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CollapseIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="30" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="30" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExitIcon" Storyboard.TargetProperty="FontSize">
                            <EasingDoubleKeyFrame KeyTime="0" Value="30" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <i:Interaction.Triggers>
            <spx:AdaptiveTrigger MinWindowWidth="0">
                <ei:GoToStateAction StateName="Adaptive0" />
            </spx:AdaptiveTrigger>
            <spx:AdaptiveTrigger MinWindowWidth="1440">
                <ei:GoToStateAction StateName="Adaptive1440" />
            </spx:AdaptiveTrigger>
            <spx:AdaptiveTrigger MinWindowWidth="3800">
                <ei:GoToStateAction StateName="Adaptive3800" />
            </spx:AdaptiveTrigger>
        </i:Interaction.Triggers>

        <!-- ============================================================
		     1. the expanded toolbar: one plate, every button on it.

		     The plate is the strip's first child and stretches with it, so it is
		     the same box as the buttons and cannot rim them. Nothing here has a
		     margin, for the same reason.
		     ============================================================ -->
        <Grid x:Name="ExpandedBar">
            <Grid x:Name="ToolButtonStrip" Height="54" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- the backdrop, laid out in the button box rather than around it.
		     ColumnSpan, because a Rectangle with no span of its own would be
		     confined to column 0 and the rest of the plate would be missing. -->
                <Rectangle x:Name="ToolChromeRectangle" Grid.ColumnSpan="9"
						   Fill="{DynamicResource ToolbarBackgroundBrush}"
						   SnapsToDevicePixels="True" />

                <!-- Every button binds its side to the strip height, so they stay
			     square at whichever tier the visual states set. -->
                <ToggleButton x:Name="SelectToggleButton" Grid.Column="0" IsChecked="True"
						  Width="{Binding Height, ElementName=ToolButtonStrip}" Height="{Binding Height, ElementName=ToolButtonStrip}"
						  Style="{DynamicResource Style.ToolbarToggleButton}"
						  ToolTip="指针"
						  PreviewMouseLeftButtonDown="ToolButton_OnPreviewMouseLeftButtonDown"
						  Click="Select_OnClick">
                                        <ui:FontIcon x:Name="SelectIcon" Glyph="&#xE569;" FontSize="18"
                      FontFamily="{DynamicResource Font.MaterialSymbolsSharp}"
                      VerticalAlignment="Center" />
                </ToggleButton>

                <ToggleButton x:Name="PenToggleButton" Grid.Column="1"
						  Width="{Binding Height, ElementName=ToolButtonStrip}" Height="{Binding Height, ElementName=ToolButtonStrip}"
						  Style="{DynamicResource Style.ToolbarToggleButton}"
						  ToolTip="画笔（再点一次选颜色）"
						  PreviewMouseLeftButtonDown="ToolButton_OnPreviewMouseLeftButtonDown"
						  Click="Pen_OnClick">
                    <Grid>
                        <!-- the pen is Material's edit glyph (U+F097), so the selected state
					     recolours it through the button Foreground for free -->
                        <ui:FontIcon x:Name="PenIcon" Glyph="&#xF097;" FontSize="18"
								 FontFamily="{DynamicResource Font.MaterialSymbolsSharp}"
								 VerticalAlignment="Center" />

                        <!-- the current ink colour, always readable without opening the
                             picker: a 4px strip riding the button's bottom edge. It lives
                             inside the button so every resolution tier gives it the right
                             height for free. -->
                        <Rectangle x:Name="PenColorIndicator" Height="4"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Bottom"
                               Fill="Red"
                               SnapsToDevicePixels="True" />
                    </Grid>
                </ToggleButton>

                <ToggleButton x:Name="EraserToggleButton" Grid.Column="2"
						  Width="{Binding Height, ElementName=ToolButtonStrip}" Height="{Binding Height, ElementName=ToolButtonStrip}"
						  Style="{DynamicResource Style.ToolbarToggleButton}"
						  ToolTip="橡皮（再点一次清除全部墨迹）"
						  PreviewMouseLeftButtonDown="ToolButton_OnPreviewMouseLeftButtonDown"
						  Click="Rubber_OnClick">
                                        <!-- One glyph covers both states now: Material's ink_eraser reads
                      as an eraser whether or not the button is checked, and the two
                      hand-drawn Paths taking turns were only ever there because MDL2
                      had no eraser glyph. The selected state recolours it through the
                      button Foreground like the other icons. -->
                    <ui:FontIcon x:Name="EraserIcon" Glyph="&#xE6D0;" FontSize="18"
                      FontFamily="{DynamicResource Font.MaterialSymbolsSharp}"
                      VerticalAlignment="Center" />
                </ToggleButton>

                <!-- 5. the collapse key. Straight after the tool group and immediately
			     left of the exit cross, so the two "get out of the way" controls sit
			     together at the end of the bar.

			     Not a ToggleButton: it has no checked state to speak of, its glyph
			     already says which way it goes (expand_more here, expand_less on the
			     folded bar), and IsToolButton only claims ToggleButtons - which is what
			     keeps a press on it from being read as "a tool button decided its own
			     menu" by the dismissal handler. -->
                <Button x:Name="CollapseButton" Grid.Column="3"
					Width="{Binding Height, ElementName=ToolButtonStrip}"
					Height="{Binding Height, ElementName=ToolButtonStrip}"
					Style="{DynamicResource Style.ToolbarButton}"
					ToolTip="收起工具栏"
					Click="CollapseToggle_OnClick">
                    <ui:FontIcon x:Name="CollapseIcon" Glyph="&#xE5CF;" FontSize="18"
						 FontFamily="{DynamicResource Font.MaterialSymbolsSharp}" />
                </Button>

                <!-- 6. exit, on the same plate as everything else now -->
                <Button x:Name="ExitButton" Grid.Column="4"
				Width="{Binding Height, ElementName=ToolButtonStrip}"
				Height="{Binding Height, ElementName=ToolButtonStrip}"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="退出放映"
				Click="Exit_OnClick">
                    <ui:FontIcon x:Name="ExitIcon" Glyph="&#xE5CD;" FontSize="18"
					 FontFamily="{DynamicResource Font.MaterialSymbolsSharp}" />
                </Button>

                <!-- The 2px outline of the whole bar. Declared after the buttons on
		     purpose: they fill the strip corner to corner, so an outline placed
		     beneath them would be covered by their plates; painted last it rings
		     the bar as a whole. Border draws inside its own box, so nothing leaks
		     past the strip edge. IsHitTestVisible off, so the two pixels that
		     overlap the outer buttons never swallow a click. -->
                <Border Grid.ColumnSpan="5" BorderThickness="2"
					BorderBrush="{DynamicResource ToolbarBorderBrush}"
					IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- ============================================================
		     2. the folded state: as wide as the bar was, half as tall, one key.

		     Width is written from code when the fold starts rather than bound to
		     the strip: an element that is out of the tree measures 0, so by the
		     time the expanded bar is hidden the number the binding would report is
		     0 and the key would collapse to nothing.

		     Bottom aligned inside RootGrid so it keeps the bar's own edge on the
		     screen edge, with the space it gave back above it not hit-testable
		     (RootGrid is exactly as tall as whichever of the two is showing).
		     ============================================================ -->
        <Grid x:Name="CollapsedBar" Height="27" VerticalAlignment="Bottom"
			  Visibility="Collapsed">
            <Rectangle x:Name="CollapsedChromeRectangle"
					   Fill="{DynamicResource ToolbarBackgroundBrush}"
					   SnapsToDevicePixels="True" />
            <Button x:Name="ExpandButton"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="展开工具栏"
				Click="CollapseToggle_OnClick">
                <ui:FontIcon x:Name="ExpandIcon" Glyph="&#xE5CE;" FontSize="18"
					 FontFamily="{DynamicResource Font.MaterialSymbolsSharp}" />
            </Button>

            <!-- same 2px outline as the expanded bar -->
            <Border BorderThickness="2"
					BorderBrush="{DynamicResource ToolbarBorderBrush}"
					IsHitTestVisible="False" />
        </Grid>
    </Grid>
</UserControl>
