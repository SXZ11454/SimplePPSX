<UserControl
	x:Class="SimplePPSX.LeftArea"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:spx="clr-namespace:SimplePPSX"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:ei="http://schemas.microsoft.com/xaml/behaviors"
	Width="56"
	Height="176">
	<!-- Left toolbar, vertical variant: previous / page number / next.

     Icon note: ModernWpfUI's SymbolIcon has no FontSize (it is hard coded in its template)
     but the icon size has to follow the resolution tier here, so the sibling control
     FontIcon is used instead. The glyph codes are taken straight from the matching
     Symbol enum members (SymbolIcon hands (char)Symbol to Segoe MDL2 Assets as well),
     so the icon looks exactly like <ui:SymbolIcon Symbol="Up"/>, only scalable.
     The full table lives at the top of Style_\ToolbarStyle.xaml. -->

	<Grid x:Name="RootGrid">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="AdaptiveStates">
				<VisualState x:Name="Adaptive0">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame KeyTime="0" Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame KeyTime="0" Value="92" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PreviousIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="11" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="NextIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="11" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftSlideIndexTextBlock" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="7" />
						</DoubleAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="Adaptive1440" />
				<VisualState x:Name="Adaptive3800">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame KeyTime="0" Value="88" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame KeyTime="0" Value="280" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PreviousIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="NextIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftSlideIndexTextBlock" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="17" />
						</DoubleAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<i:Interaction.Triggers>
			<spx:AdaptiveTrigger MinWindowWidth="0">
				<ei:GoToStateAction StateName="Adaptive0" />
			</spx:AdaptiveTrigger>
			<spx:AdaptiveTrigger MinWindowWidth="1440">
				<ei:GoToStateAction StateName="Adaptive1440" />
			</spx:AdaptiveTrigger>
			<spx:AdaptiveTrigger MinWindowWidth="3800">
				<ei:GoToStateAction StateName="Adaptive3800" />
			</spx:AdaptiveTrigger>
		</i:Interaction.Triggers>

		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- 1. backdrop: a Rectangle, so there is no corner to round in the first place -->
		<Rectangle x:Name="ChromeRectangle" Grid.RowSpan="3"
				 Fill="{DynamicResource ToolbarBackgroundBrush}"
				 SnapsToDevicePixels="True" />

		<Button x:Name="PreviousButton" Grid.Row="0"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="上一页"
				Click="Previous_Click">
			<ui:FontIcon x:Name="PreviousIcon" Glyph="&#xE5CB;" FontSize="16"
						 FontFamily="{DynamicResource Font.MaterialSymbolsSharp}" />
		</Button>

		<Button x:Name="ThumbnailButton" Grid.Row="1"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="幻灯片缩略图"
				Click="Thumbnail_Click">
			<TextBlock x:Name="LeftSlideIndexTextBlock"
					   FontFamily="Microsoft YaHei UI"
					   FontSize="11"
					   Style="{DynamicResource Style.ToolbarIndexText}" />
		</Button>

		<Button x:Name="NextButton" Grid.Row="2"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="下一页"
				Click="Next_Click">
			<!-- The Symbol enum has no page navigation pair, so the chevrons come straight from MDL2: previous is the left chevron, next the right one, in both the vertical and the horizontal toolbar. -->
			<ui:FontIcon x:Name="NextIcon" Glyph="&#xE5CC;" FontSize="16"
						 FontFamily="{DynamicResource Font.MaterialSymbolsSharp}" />
		</Button>

		<!-- 2px outline of the whole bar, painted above the buttons (they fill the
		     grid) and never hit-testable. See BottomArea.xaml for the full note. -->
		<Border Grid.RowSpan="3" BorderThickness="2"
				BorderBrush="{DynamicResource ToolbarBorderBrush}"
				IsHitTestVisible="False" />
	</Grid>
</UserControl>
