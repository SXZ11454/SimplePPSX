<Window
	x:Class="SimplePPSX.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:spx="clr-namespace:SimplePPSX"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:ei="http://schemas.microsoft.com/xaml/behaviors"
	Opacity="0"
	WindowStartupLocation="Manual"
	Style="{DynamicResource Style.Window}"
	ShowActivated="False"
	Width="1"
	Height="1">
	<!--
	  The transparent overlay that covers the whole screen while PowerPoint presents.

	  ShowActivated is False because this window is shown once at start-up when the
	  preload switch is on (ViewHelper.PreloadOverlay). Activating it there would
	  take the keyboard away from whatever the user was doing. The presentation is
	  what wants focus, and that ask is explicit: _pptOperatorShowBegin calls
	  Activate() itself.

	  Z-order (later Grid children sit on top):
	    1. the eraser and pen colour panels
	    2. the three toolbars (left / center / right)
	    3. the full-screen click-through mask
	    4. the two thumbnail panels  <- above the mask, see the note at the
	                                    bottom of this file
	    5. the QR code mask

	  The three toolbars are pinned to the bottom edge and laid out left / center /
	  right on one row by ApplyToolbarPlacements. The thumbnail panels stand
	  directly on top of that row, at the left and right edges, and grow upward
	  into the space above it. The only per-UI decisions left in this file are
	  the z-order and the empty hosting Grids.
	-->
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/SimplePPSX;component/Style_/WindowStyle.xaml" />
				<ResourceDictionary Source="pack://application:,,,/SimplePPSX;component/Style_/Buttonstyle.xaml" />
				<!--
				  Style_\ToolbarStyle.xaml is merged at application level (App.xaml):
				  ToolbarAppearance only knows that one instance of the backdrop brushes.
				-->
			</ResourceDictionary.MergedDictionaries>

			<!--
			  After seven seconds without a page change the side toolbars dim down to
			  30% opacity. Only the opacity changes, the position stays where the
			  placement says it is.
			-->
			<Storyboard x:Key="ShowLeftCenterButtonGridStoryBoard">
				<DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftToolbarHost" Storyboard.TargetProperty="Opacity" Completed="ShowLeftCenterButtonGrid_OnCompleted">
					<EasingDoubleKeyFrame KeyTime="0" Value="1" />
				</DoubleAnimationUsingKeyFrames>
				<DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftBottomToolbarHost" Storyboard.TargetProperty="Opacity">
					<EasingDoubleKeyFrame KeyTime="0" Value="1" />
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
			<Storyboard x:Key="HiddenLeftCenterButtonGridStoryBoard">
				<DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftToolbarHost" Storyboard.TargetProperty="Opacity">
					<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
					<EasingDoubleKeyFrame KeyTime="0:0:6" Value="1" />
					<EasingDoubleKeyFrame KeyTime="0:0:7" Value="0.3" />
				</DoubleAnimationUsingKeyFrames>
				<DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftBottomToolbarHost" Storyboard.TargetProperty="Opacity">
					<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
					<EasingDoubleKeyFrame KeyTime="0:0:6" Value="1" />
					<EasingDoubleKeyFrame KeyTime="0:0:7" Value="0.3" />
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
			<Storyboard x:Key="ShowRightCenterButtonGridStoryBoard">
				<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightToolbarHost" Storyboard.TargetProperty="Opacity" Completed="ShowRightCenterButtonGrid_OnCompleted">
					<EasingDoubleKeyFrame KeyTime="0" Value="1" />
				</DoubleAnimationUsingKeyFrames>
				<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightBottomToolbarHost" Storyboard.TargetProperty="Opacity">
					<EasingDoubleKeyFrame KeyTime="0" Value="1" />
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
			<Storyboard x:Key="HiddenRightCenterButtonGridStoryBoard">
				<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightToolbarHost" Storyboard.TargetProperty="Opacity">
					<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
					<EasingDoubleKeyFrame KeyTime="0:0:6" Value="1" />
					<EasingDoubleKeyFrame KeyTime="0:0:7" Value="0.3" />
				</DoubleAnimationUsingKeyFrames>
				<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightBottomToolbarHost" Storyboard.TargetProperty="Opacity">
					<EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
					<EasingDoubleKeyFrame KeyTime="0:0:6" Value="1" />
					<EasingDoubleKeyFrame KeyTime="0:0:7" Value="0.3" />
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>

	<Grid x:Name="RootGrid" FocusManager.IsFocusScope="True" Margin="0">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>

		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="AdaptiveStates">
				<VisualState x:Name="Adaptive0">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value>
									<Thickness>3 1 3 3</Thickness>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="Adaptive1440" />
				<VisualState x:Name="Adaptive3800">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value>
									<Thickness>12 1 12 12</Thickness>
								</ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<i:Interaction.Triggers>
			<spx:AdaptiveTrigger MinWindowWidth="0">
				<ei:GoToStateAction StateName="Adaptive0" />
			</spx:AdaptiveTrigger>
			<spx:AdaptiveTrigger MinWindowWidth="1440">
				<ei:GoToStateAction StateName="Adaptive1440" />
			</spx:AdaptiveTrigger>
			<spx:AdaptiveTrigger MinWindowWidth="3800">
				<ei:GoToStateAction StateName="Adaptive3800" />
			</spx:AdaptiveTrigger>
		</i:Interaction.Triggers>

		<!-- ============================================================
		     1. the eraser and pen colour panels, bottom-aligned in row 0, so
		        they unfold upwards straight out of the centre toolbar without
		        moving it. (The thumbnail panels are at the very bottom of this
		        file; they had to move there to be clickable.)
		     ============================================================ -->
		<!-- The eraser panel and the pen colour panel. They sit in the row ABOVE the
		     toolbars, bottom-aligned, so a panel appears directly above the centre
		     toolbar without that toolbar moving. Both are ordinary elements rather than
		     Flyout popups: the overlay window is full-screen, click-through and
		     transparent, and a separate popup window had to fight all three to be
		     visible and clickable.

		     The hosts are left Visible on purpose. BottomArea collapses and shows the
		     PANELS inside them, and a Grid with no Background and no visible child is
		     not hit-testable, so an always-visible empty host costs nothing and cannot
		     swallow clicks. Collapsing a host instead would hide its panel the moment
		     it was shown. -->
		<!-- Width tracks the centre toolbar so a panel is exactly as wide as the row it
		     grows out of. That is what makes it read as the toolbar unfolding upwards
		     rather than as a separate box that happens to be near it. The toolbar is
		     sized by its own content and changes with the resolution tier, so the width
		     is bound rather than written down. -->
		<StackPanel x:Name="ToolPanelStack" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
					HorizontalAlignment="Center" VerticalAlignment="Bottom"
					Width="{Binding ActualWidth, ElementName=CenterToolbarHost}"
					Background="Transparent">
			<Grid x:Name="EraserPanelHost" />
			<Grid x:Name="ColorPanelHost" />
		</StackPanel>

		<!-- ============================================================
		     2. the three toolbars: left / center / right, all on one row
		        along the bottom edge. Row 1 is the bottom row of the grid.
		     ============================================================ -->
		<Grid x:Name="LeftToolbarHost" Grid.Row="1" Grid.Column="0"
			  HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" />
		<Grid x:Name="LeftBottomToolbarHost" Grid.Row="1" Grid.Column="0"
			  HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" />
		<Grid x:Name="CenterToolbarHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
			  HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" />
		<Grid x:Name="RightToolbarHost" Grid.Row="1" Grid.Column="2"
			  HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" />
		<Grid x:Name="RightBottomToolbarHost" Grid.Row="1" Grid.Column="2"
			  HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" />

		<!-- ============================================================
		     3. mask: swallows the first click while a thumbnail panel is
		        open, so the click closes the panel instead of reaching
		        PowerPoint. (The whiteboard used to have a second, lower
		        mask; it went with the whiteboard.)
		     ============================================================ -->
		<Button x:Name="HighMaskButton"
				Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3"
				Visibility="Collapsed"
				Style="{StaticResource NoButtonStyle}"
				PreviewMouseLeftButtonDown="HighMaskButton_Click" />

		<!-- ============================================================
		     4. QR code mask
		     ============================================================ -->
		<Grid x:Name="QrGrid"
			  Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3"
			  Visibility="Collapsed"
			  Background="#27000000"
			  MouseLeftButtonDown="QrGrid_OnMouseLeftButtonDown">
			<Border Width="700" Height="700" VerticalAlignment="Center" HorizontalAlignment="Center">
				<Image x:Name="QrImage" Width="700" Height="700" Visibility="Collapsed" />
			</Border>
		</Grid>

		<!-- ============================================================
		     5. the two thumbnail panel hosts, above the mask and below
		        the QR layer.

		        They used to be declared with the other hosts at the top of the
		        grid, which put a full-screen always-hit-testable mask Button
		        on top of them: every click on a thumbnail or on a page number
		        was taken by the mask, which closed the panel, so nothing inside
		        a panel could ever be clicked. Declared here, they are above the
		        mask, and the panel keeps its own clicks - while the mask still
		        covers the whole presentation and does its job everywhere else.

		        Row 0 only, and stretched: the panel therefore stands directly
		        on top of the toolbar row and grows upward into the space above
		        it, which is what SlideThumbnailPanel caps its own height to.
		     ============================================================ -->
		<Grid x:Name="LeftThumbnailHost" Grid.Row="0" Grid.Column="0"
			  HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="Collapsed" />
		<Grid x:Name="RightThumbnailHost" Grid.Row="0" Grid.Column="2"
			  HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="Collapsed" />
	</Grid>
</Window>
