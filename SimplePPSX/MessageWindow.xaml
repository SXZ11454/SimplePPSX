<Window
	x:Class="SimplePPSX.MessageWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="MessageWindow"
	Style="{DynamicResource Style.Window}"
	WindowStartupLocation="Manual"
	xmlns:spx="clr-namespace:SimplePPSX">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary
					Source="pack://application:,,,/SimplePPSX;component/Style_/WindowStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Storyboard
				x:Key="Style.ShowMessage">
				<DoubleAnimationUsingKeyFrames
					Storyboard.TargetProperty="Opacity"
					Storyboard.TargetName="MessageBorder"
					Completed="Timeline_OnCompleted">
					<EasingDoubleKeyFrame
						KeyTime="0"
						Value="0" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.2"
						Value="0.5" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:0.3"
						Value="1" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:1.5"
						Value="1" />
					<EasingDoubleKeyFrame
						KeyTime="0:0:2"
						Value="0" />
				</DoubleAnimationUsingKeyFrames>
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<Border
			x:Name="MessageBorder"
			Grid.Row="0"
			Background="#19000000"
			CornerRadius="6"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Opacity="0">
			<TextBlock
				x:Name="MessageTextBlock"
				FontSize="18"
				Margin="30 10 30 10"
				Foreground="#666666"
				Text="{Binding Message}" />
		</Border>
		<Grid
			x:Name="PerchGrid"
			Row="1"
			Height="80"
			Opacity="0" />
	</Grid>
</Window>
