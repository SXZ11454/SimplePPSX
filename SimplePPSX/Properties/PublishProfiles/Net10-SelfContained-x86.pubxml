<?xml version="1.0" encoding="utf-8"?>
<!--
  Current build (net10.0-windows), self-contained, single exe.

  Publish with:
      dotnet publish SimplePPSX\SimplePPSX.csproj -p:TargetFramework=net10.0-windows -p:PublishProfile=Net10-SelfContained-x86

  What is special here
  ===================
  * SelfContained = true bundles the .NET 10 desktop runtime, so the target
    machine needs no .NET installation at all. That is the same deal as the
    Win7 profile offers on net6, and the machine still has to be Windows 10
    1607 or later - .NET 10 does not run on Windows 7, no matter how it is
    packaged. For Windows 7 use Win7-Net6-x86.
  * win-x86 because the app has to be 32-bit: it drives 32-bit PowerPoint
    through COM and talks to HID hardware directly. A 64-bit process cannot
    load the 32-bit pieces.
  * SingleFile keeps the result to one exe, the same shape as the Win7
    profile, so both self-contained builds are distributed the same way.
    IncludeNativeLibrariesForSelfExtract is required because WPF and Windows
    Forms mix managed and native bits, and compression keeps the exe down -
    the runtime inside it is the bulk of the file.
  * The plain-folder, framework-dependent variant of net10 is Net10-x86;
    flip PublishSingleFile and SelfContained there rather than editing this
    profile, so the two stay readable side by side.
  * PublishTrimmed stays false: trimming breaks WPF XAML that is reached only
    through resources, and nothing here is small enough to be worth the risk.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Configuration>Release</Configuration>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
