<?xml version="1.0" encoding="utf-8"?>
<!--
  Current build (net10.0-windows), framework dependent, plain folder output.

  Publish with:
      dotnet publish SimplePPSX\SimplePPSX.csproj -p:TargetFramework=net10.0-windows -p:PublishProfile=Net10-x86

  Framework dependent on purpose: the .NET 10 desktop runtime is expected to be
  present, which keeps the output folder small. For a copy that carries its own
  runtime (one exe, no install on the target machine) use
  Net10-SelfContained-x86 instead of flipping the flags here - that is what the
  self-contained profile is for.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Configuration>Release</Configuration>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
