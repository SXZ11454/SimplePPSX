<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 7 fallback build.

  Publish with:
      dotnet publish SimplePPSX\SimplePPSX.csproj -p:TargetFramework=net6.0-windows -p:PublishProfile=Win7-Net6-x86

  What is special here
  ===================
  * net6.0-windows is the oldest target in the project. Windows 7 SP1 is out of
    support for .NET 6 as well, so this configuration is a best effort one, not a
    supported combination.
  * SelfContained = true bundles the runtime, so the target machine needs no
    .NET installation at all. Set it to false (and keep PublishSingleFile) if the
    machine already has the .NET 6 desktop runtime.
  * win-x86 because the app has to be 32-bit: it drives 32-bit PowerPoint
    through COM and talks to HID hardware directly.
  * SingleFile keeps the result to a single exe, which is what copying the
    folder onto a classroom PC wants. IncludeNativeLibrariesForSelfExtract is
    required because WPF and Windows Forms mix managed and native bits.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Configuration>Release</Configuration>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
