<UserControl
	x:Class="SimplePPSX.RightArea"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:spx="clr-namespace:SimplePPSX"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:ei="http://schemas.microsoft.com/xaml/behaviors"
	Width="56"
	Height="176">
	<!-- Right toolbar, vertical variant: identical in structure to the left one.
     Placement is left to MainWindow: this toolbar sits along the bottom
     edge, right-hand end of the row.
     Why FontIcon rather than SymbolIcon: see the note in LeftArea.xaml. -->

	<Grid x:Name="RootGrid">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="AdaptiveStates">
				<VisualState x:Name="Adaptive0">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame KeyTime="0" Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame KeyTime="0" Value="92" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PreviousIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="11" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="NextIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="11" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightSlideIndexTextBlock" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="7" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="DividerTop" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value><Thickness>7,2,7,2</Thickness></ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="DividerBottom" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value><Thickness>7,2,7,2</Thickness></ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="Adaptive1440" />
				<VisualState x:Name="Adaptive3800">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Width)">
							<EasingDoubleKeyFrame KeyTime="0" Value="88" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(FrameworkElement.Height)">
							<EasingDoubleKeyFrame KeyTime="0" Value="280" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PreviousIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="NextIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightSlideIndexTextBlock" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="17" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="DividerTop" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value><Thickness>16,13,16,13</Thickness></ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="DividerBottom" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value><Thickness>16,13,16,13</Thickness></ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<i:Interaction.Triggers>
			<spx:AdaptiveTrigger MinWindowWidth="0">
				<ei:GoToStateAction StateName="Adaptive0" />
			</spx:AdaptiveTrigger>
			<spx:AdaptiveTrigger MinWindowWidth="1440">
				<ei:GoToStateAction StateName="Adaptive1440" />
			</spx:AdaptiveTrigger>
			<spx:AdaptiveTrigger MinWindowWidth="3800">
				<ei:GoToStateAction StateName="Adaptive3800" />
			</spx:AdaptiveTrigger>
		</i:Interaction.Triggers>

		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- 1. backdrop -->
		<Rectangle x:Name="ChromeRectangle" Grid.RowSpan="5"
				 Fill="{DynamicResource ToolbarBackgroundBrush}"
				 SnapsToDevicePixels="True" />

		<Button x:Name="PreviousButton" Grid.Row="0"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="上一页"
				Click="Previous_Click">
			<ui:FontIcon x:Name="PreviousIcon" Glyph="&#xE76B;" FontSize="16"
						 FontFamily="{DynamicResource SymbolThemeFontFamily}" />
		</Button>

		<Grid Grid.Row="1">
			<Rectangle x:Name="DividerTop" Height="1" Margin="9,5" VerticalAlignment="Center"
					   Fill="{DynamicResource ToolbarDividerBrush}" SnapsToDevicePixels="True" />
		</Grid>

		<Button x:Name="ThumbnailButton" Grid.Row="2"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="幻灯片缩略图"
				Click="Thumbnail_Click">
			<TextBlock x:Name="RightSlideIndexTextBlock"
					   FontFamily="Microsoft YaHei UI"
					   FontSize="11"
					   Style="{DynamicResource Style.ToolbarIndexText}" />
		</Button>

		<Grid Grid.Row="3">
			<Rectangle x:Name="DividerBottom" Height="1" Margin="9,5" VerticalAlignment="Center"
					   Fill="{DynamicResource ToolbarDividerBrush}" SnapsToDevicePixels="True" />
		</Grid>

		<Button x:Name="NextButton" Grid.Row="4"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="下一页"
				Click="Next_Click">
			<ui:FontIcon x:Name="NextIcon" Glyph="&#xE76C;" FontSize="16"
						 FontFamily="{DynamicResource SymbolThemeFontFamily}" />
		</Button>
	</Grid>
</UserControl>
