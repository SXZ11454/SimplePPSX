<UserControl
	x:Class="SimplePPSX.RightBottomArea"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:spx="clr-namespace:SimplePPSX"
	xmlns:ui="http://schemas.modernwpf.com/2019"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:ei="http://schemas.microsoft.com/xaml/behaviors"
	Width="176"
	Height="56">
	<!-- Right toolbar, horizontal variant (used by Office 2016 and newer).
     Structurally identical to the left one; placement is left to MainWindow, which
     pins the row along the bottom edge.
     Why FontIcon rather than SymbolIcon: see the note in LeftArea.xaml.

     The Adaptive states no longer resize RootGrid, and the long note in
     LeftBottomArea.xaml explains why: MinWindowWidth="0" matches every window, so
     Adaptive0 was shrinking this Grid to 92x30 inside a 176x56 control, which left
     the three buttons overlapping each other in Width="*" columns of a 92px grid.
     The topmost button then took every click aimed at the other two. The tiers
     still scale the glyphs and the divider margins, exactly as LeftArea does. -->

	<Grid x:Name="RootGrid">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="AdaptiveStates">
				<VisualState x:Name="Adaptive0">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PreviousIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="11" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="NextIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="11" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightSlideIndexTextBlock" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="7" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="DividerLeft" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value><Thickness>2,7,2,7</Thickness></ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="DividerRight" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value><Thickness>2,7,2,7</Thickness></ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="Adaptive1440" />
				<VisualState x:Name="Adaptive3800">
					<Storyboard>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="PreviousIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="NextIcon" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="30" />
						</DoubleAnimationUsingKeyFrames>
						<DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightSlideIndexTextBlock" Storyboard.TargetProperty="FontSize">
							<EasingDoubleKeyFrame KeyTime="0" Value="17" />
						</DoubleAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="DividerLeft" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value><Thickness>2,13,2,13</Thickness></ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="DividerRight" Storyboard.TargetProperty="Margin">
							<DiscreteObjectKeyFrame KeyTime="0">
								<ObjectKeyFrame.Value><Thickness>2,13,2,13</Thickness></ObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<i:Interaction.Triggers>
			<spx:AdaptiveTrigger MinWindowWidth="0">
				<ei:GoToStateAction StateName="Adaptive0" />
			</spx:AdaptiveTrigger>
			<spx:AdaptiveTrigger MinWindowWidth="1440">
				<ei:GoToStateAction StateName="Adaptive1440" />
			</spx:AdaptiveTrigger>
			<spx:AdaptiveTrigger MinWindowWidth="3800">
				<ei:GoToStateAction StateName="Adaptive3800" />
			</spx:AdaptiveTrigger>
		</i:Interaction.Triggers>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- 1. backdrop -->
		<Rectangle x:Name="ChromeRectangle" Grid.ColumnSpan="5"
				 Fill="{DynamicResource ToolbarBackgroundBrush}"
				 SnapsToDevicePixels="True" />

		<Button x:Name="PreviousButton" Grid.Column="0"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="上一页"
				Click="Previous_Click">
			<ui:FontIcon x:Name="PreviousIcon" Glyph="&#xE76B;" FontSize="16"
						 FontFamily="{DynamicResource SymbolThemeFontFamily}" />
		</Button>

		<Grid Grid.Column="1">
			<Rectangle x:Name="DividerLeft" Width="1" Margin="5,9" HorizontalAlignment="Center"
					   Fill="{DynamicResource ToolbarDividerBrush}" SnapsToDevicePixels="True" />
		</Grid>

		<Button x:Name="ThumbnailButton" Grid.Column="2"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="幻灯片缩略图"
				Click="Thumbnail_Click">
			<TextBlock x:Name="RightSlideIndexTextBlock"
					   FontFamily="Microsoft YaHei UI"
					   FontSize="11"
					   Style="{DynamicResource Style.ToolbarIndexText}" />
		</Button>

		<Grid Grid.Column="3">
			<Rectangle x:Name="DividerRight" Width="1" Margin="5,9" HorizontalAlignment="Center"
					   Fill="{DynamicResource ToolbarDividerBrush}" SnapsToDevicePixels="True" />
		</Grid>

		<Button x:Name="NextButton" Grid.Column="4"
				Style="{DynamicResource Style.ToolbarButton}"
				ToolTip="下一页"
				Click="Next_Click">
			<ui:FontIcon x:Name="NextIcon" Glyph="&#xE76C;" FontSize="16"
						 FontFamily="{DynamicResource SymbolThemeFontFamily}" />
		</Button>
	</Grid>
</UserControl>
