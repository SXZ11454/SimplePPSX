<Window x:Class="SimplePPSX.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:spx="clr-namespace:SimplePPSX"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="设置"
        Height="720" Width="900"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <!--
      The settings window. The chrome is entirely ModernWpfUI: ui:WindowHelper adds
      the title bar with its minimise / maximise / close buttons, and the content is
      one SettingsPage.
    -->
    <spx:SettingsPage x:Name="Page" />
</Window>
