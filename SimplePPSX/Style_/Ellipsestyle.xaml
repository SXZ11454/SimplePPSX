<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style
		x:Key="ThumbEllipseStyle"
		TargetType="{x:Type Ellipse}">
		<Setter
			Property="Fill"
			Value="#FFFFFF" />
		<Setter
			Property="Stroke"
			Value="#AAAAAA" />
		<Setter
			Property="UIElement.Effect"
			Value="{x:Null}" />
	</Style>
</ResourceDictionary>
