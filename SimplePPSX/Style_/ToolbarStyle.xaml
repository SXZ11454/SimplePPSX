<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:spx="clr-namespace:SimplePPSX"
	xmlns:ui="http://schemas.modernwpf.com/2019">

	<!-- =========================================================
	     The pieces of UI that float above PowerPoint while presenting:
	     three toolbars plus the thumbnail panels. Everything is built
	     on ModernWpfUI controls (Button / ToggleButton / ListBox /
	     Flyout), and every corner is square.

	     The icons are glyphs from Material Symbols Sharp, shipped with
	     the app in Fonts and named by the Font.MaterialSymbolsSharp
	     font family resource in App.xaml. The mapping:

	       previous slide      chevron_left   U+E5CB
	       next slide          chevron_right  U+E5CC
	       pen                 edit           U+F097
	       pointer             near_me        U+E569
	       eraser              ink_eraser     U+E6D0
	       leave presentation  close          U+E5CD
	       settings            settings       U+E8B8
	       fold the toolbar    expand_more    U+E5CF
	       unfold it           expand_less    U+E5CE

	     The chevrons carry over unchanged from the old MDL2 pair:
	     both fonts draw them at the same visual weight and position,
	     so every area's prev/next pair kept its meaning across the swap.
	     The pointer and the eraser used to be hand-drawn Paths because
	     MDL2 had no mouse or rubber glyph that read right at this size;
	     Material has both, so all three tool icons are one font now. The
	     tier storyboards size them through FontSize - FontIcon has none
	     of the sizing limits SymbolIcon had (its template hard codes
	     20px, which is why FontIcon was picked over SymbolIcon in the
	     first place), and a named glyph follows FontSize like text.

	     The exit button is a plain cross. It was StopSlideShow (a filled
	     square, which reads as "stop") and then the power glyph; the cross
	     is what the rest of the toolbar uses to mean "close", so it matches.

	     The magnifier and the embedded whiteboard were removed from the toolbar.
	     ========================================================= -->

	<!-- =========================================================
	     Backdrop brushes - the colours of every piece of toolbar chrome.

	     None of the ten Toolbar*Brush resources is declared here: they are
	     stamped into the application resources by ToolbarTheme.Apply, from
	     a light and a dark table, and restamped on every theme switch. They
	     carry no alpha on purpose: WPF freezes freezable resources (and
	     ModernWpf's ThemeManager freezes the application resources as
	     well), so the opacity cannot be written onto a brush. The alpha
	     lives on the Rectangles themselves, driven by ToolbarAppearance,
	     which registers each of them. The light colours match the old
	     design: backdrop #A0FFFFFF, outline and hairlines #80666666.

	     Consumers must resolve these keys with DynamicResource: a
	     StaticResource captures whatever brush the key held when the style
	     was parsed, and would keep it - in the wrong colours - across a
	     light/dark switch. The four setters that still used StaticResource
	     (this file's index text style and slider track, two setters in
	     SquareCorners.xaml) were converted with the move.
	     ========================================================= -->

	<!-- NOTE: Style.ToolbarButton and Style.ToolbarToggleButton are NOT here.
	     They live in Style_\SquareCorners.xaml, next to the DefaultButtonStyle
	     and DefaultToggleButtonStyle they derive from.

	     The reason is load order, and it cost two wrong attempts to find. A
	     StaticResource in a merged ResourceDictionary is resolved while that
	     dictionary is being parsed, and App.xaml merges ToolbarStyle.xaml
	     BEFORE SquareCorners.xaml. A style in here can therefore not
	     BasedOn a key that only SquareCorners.xaml defines - the lookup
	     happens before that dictionary is in the list. (DynamicResource is
	     no escape either: Style.BasedOn is a plain CLR property, not a
	     dependency property, so a DynamicResource on it is refused outright
	     with XamlParseException.)

	     Putting both the base styles and the toolbar styles in the one
	     dictionary that is merged last sidesteps the whole problem, and it is
	     also what SimpleRollCall does: it redefines ModernWpf's
	     DefaultButtonStyle inside its own last-merged SquareCorners.xaml
	     rather than referencing the library's copy. -->

	<!-- The page number in the middle of the left/right toolbars ("3/12"). -->
	<Style x:Key="Style.ToolbarIndexText" TargetType="{x:Type TextBlock}">
		<Setter Property="Foreground" Value="{DynamicResource ToolbarForegroundBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextAlignment" Value="Center" />
		<Setter Property="Focusable" Value="False" />
	</Style>

	<!-- =========================================================
	     The eraser menu's slider.

	     An iOS-style switch rather than a WPF slider: a 34px bar with a
	     34x34 handle that fills the whole height, and the stretch of bar
	     to the LEFT of the handle filled in the accent colour. So the
	     handle reads as "how far", and the accent as "how much is armed" -
	     the same reading an iOS switch gives, which is what makes it
	     obvious that dragging right to the end is the action.

	     The handle is a white block with a transparent left half; the half
	     fills with a darker accent (#005FB8) while the mouse is held on
	     it, so "I am dragging it right now" is visible too.

	     Square corners throughout, like everything else here. Every
	     Background below is Transparent rather than unset, because a Border
	     with no Background is not hit-testable at all and the slider would
	     stop responding to clicks on the bar.
	     ========================================================= -->
	<Style x:Key="Style.ThickSlider" TargetType="{x:Type Slider}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Height" Value="34" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Slider}">
					<Grid Background="Transparent">
						<!-- The pale plate the bar runs inside.
						     The accent fill and the untravelled part are drawn on top of
						     this rather than being the whole bar, so the track reads as a
						     groove wrapped in a light background instead of two loose
						     strips floating on the panel. -->
						<Border Height="26" VerticalAlignment="Center"
								Background="{DynamicResource ToolbarTrackPlateBrush}" />

						<!-- The done tick.
						     Centred on the BAR, not on the handle, so it reads as "this is
						     finished" rather than as another handle state. Black, because the
						     handle is white and the accent fill can be light or dark depending
						     on the user's accent colour, so neither white nor the accent is
						     guaranteed to read on top of it.

						     Visibility is driven from code (BottomArea.HookEraserSliderDrag
						     -> UpdateEraserDoneTick) because "the value has reached
						     Maximum" is a comparison, and a Style trigger can only match an
						     exact value. -->
						<Path x:Name="EraserDoneTick" Visibility="Collapsed"
							  Data="M 4,10 L 8.5,14.5 L 16,6"
							  Stroke="Black" StrokeThickness="2.5"
							  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
							  Width="20" Height="20" Stretch="Uniform"
							  HorizontalAlignment="Center" VerticalAlignment="Center"
							  SnapsToDevicePixels="True" IsHitTestVisible="False" />

						<!-- PART_Track is the only part WPF's Slider binds to itself:
						     it pushes Minimum / Maximum / Value into it, and reads the
						     handle's drag back out of it. -->
						<Track x:Name="PART_Track" Height="34" VerticalAlignment="Center">
							<!-- the accent already travelled -->
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="Slider.DecreaseLarge"
											  Focusable="False" IsTabStop="False"
											  Background="Transparent">
									<RepeatButton.Template>
										<ControlTemplate TargetType="{x:Type RepeatButton}">
											<Border Height="14" VerticalAlignment="Center"
													Background="{DynamicResource SystemControlHighlightAccentBrush}"
													SnapsToDevicePixels="True" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb Width="34" Height="34" Focusable="False">
									<Thumb.Template>
										<ControlTemplate TargetType="{x:Type Thumb}">
											<Grid Background="Transparent" SnapsToDevicePixels="True">
												<!-- A plain white handle with a #666 outline. It used to carry a
											     second, transparent half that filled with a darker accent
											     while the mouse was held on it. That was removed: the
											     requirement is that holding the slider changes nothing,
											     and the state of the action is shown once, at the end,
											     by the tick in the middle of the bar. -->
												<Border Background="#FFFFFFFF" BorderBrush="#FF666666" BorderThickness="1" />
											</Grid>
										</ControlTemplate>
									</Thumb.Template>
								</Thumb>
							</Track.Thumb>
							<!-- what is left to travel -->
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="Slider.IncreaseLarge"
											  Focusable="False" IsTabStop="False"
											  Background="Transparent">
									<RepeatButton.Template>
										<ControlTemplate TargetType="{x:Type RepeatButton}">
											<Border Height="14" VerticalAlignment="Center"
													Background="Transparent"
													SnapsToDevicePixels="True" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseRepeatButton>
						</Track>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- Pen colour swatches. The old design was a ring-shaped colour wheel; it is now
	     a grid of flat squares, which also removes the last round shape from the
	     toolbars. BottomArea builds one of these per entry of its colour list. -->
	<Style x:Key="Style.ToolbarColorSwatch" TargetType="{x:Type RadioButton}">
		<Setter Property="Width" Value="24" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Margin" Value="3" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RadioButton}">
					<!-- The Ring is the selection outline; the inset Border is the colour
					     itself, and pulls Margin 2 off the Ring so the ring frames it. -->
					<Grid Background="Transparent" SnapsToDevicePixels="True">
						<Border x:Name="Ring" Background="Transparent"
								BorderThickness="2" BorderBrush="Transparent"
								SnapsToDevicePixels="True" />
						<Border Margin="2" Background="{TemplateBinding Background}"
								SnapsToDevicePixels="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Ring" Property="BorderBrush" Value="#FFB0B0B0" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Ring" Property="BorderBrush" Value="#FF1B1B1B" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- =========================================================
	     Thumbnail panel

	     The vertical structure of one entry is: number, gap, image, gap,
	     then the next entry - that is, "number, image, number ..." going
	     down the panel. The gap is a hairline narrower than the image,
	     which visually separates the two kinds of content.

	     Three resolution tiers; only the sizes and the font size differ,
	     so they are written out three times rather than parameterised.
	     ========================================================= -->

	<!-- Shown while a thumbnail is still being analysed; the old line-art frame. -->
	<DrawingImage x:Key="ImageSource.Placeholder">
		<DrawingImage.Drawing>
			<DrawingGroup>
				<DrawingGroup.Children>
					<GeometryDrawing Brush="{x:Null}">
						<GeometryDrawing.Pen>
							<Pen Brush="#FFDDDDDD" Thickness="1" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" />
						</GeometryDrawing.Pen>
						<GeometryDrawing.Geometry>
							<StreamGeometry>M0,0 L36,0 L36,28 L0,28 L0,0</StreamGeometry>
						</GeometryDrawing.Geometry>
					</GeometryDrawing>
					<GeometryDrawing Brush="#FFDDDDDD">
						<GeometryDrawing.Geometry>
							<RectangleGeometry Rect="6,8,24,1" />
						</GeometryDrawing.Geometry>
					</GeometryDrawing>
					<GeometryDrawing Brush="#FFDDDDDD">
						<GeometryDrawing.Geometry>
							<RectangleGeometry Rect="6,13,18,1" />
						</GeometryDrawing.Geometry>
					</GeometryDrawing>
					<GeometryDrawing Brush="#FFDDDDDD">
						<GeometryDrawing.Geometry>
							<RectangleGeometry Rect="6,18,12,1" />
						</GeometryDrawing.Geometry>
					</GeometryDrawing>
				</DrawingGroup.Children>
			</DrawingGroup>
		</DrawingImage.Drawing>
	</DrawingImage>

	<!-- Tag carries IsPptThumbnail so the template can decide between the real
	     thumbnail and the placeholder with a single trigger, instead of a
	     converter in code. -->
	<Style x:Key="Style.ThumbnailItem0" TargetType="{x:Type ListBoxItem}">
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Tag" Value="{Binding IsPptThumbnail}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ListBoxItem}">
					<!--
						Background="Transparent" is load bearing, not decoration.

						A Grid with no Background is not hit-testable, so before this the
						only part of an entry that could receive a click was the white
						plate under the thumbnail itself. A click on the page number fell
						straight through the panel to the full-screen mask behind it -
						which closed the panel. The user asked for both the thumbnail and
						its number to be clickable, and one transparent background is what
						makes the whole entry clickable.

						Width is bound to MainWindow.SlideThumbnailWidth rather than
						written down: it is what is left of the panel once the list's own
						padding comes off it, and the panel is measured to match the side
						toolbar beside it. The FallbackValue is this tier's old fixed width,
						which is what the first frame draws, before any toolbar has been
						measured.

						This Grid, the number column and the thumbnail are all bound: the
						Grid to the entry width, the image to SlideThumbnailImageWidth /
						SlideThumbnailImageHeight. A Grid does not grow past its own
						Width, so an image wider than the entry would hang outside it
						and be cut off by the ListBox's ScrollViewer.
					-->
					<Grid Background="Transparent" Margin="0,0,0,10"
						Width="{Binding SlideThumbnailWidth, FallbackValue=120, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<Grid.ColumnDefinitions>
							<!-- the number's own column, fixed so the images line
								up down the list whatever digits each entry
								carries -->
							<ColumnDefinition Width="{Binding SlideThumbnailNumberColumn, FallbackValue=22, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<!-- 1. the number: plain grey, and the theme accent for
								the slide that is showing.

							It stands BESIDE the image now, on the panel's outer
							side - left of the image on the left panel; the right
							panel's trigger below moves it to the other column
							and flips its alignment with it. -->
						<TextBlock x:Name="IndexText" Grid.Column="0"
								Margin="0,0,4,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Text="{Binding Index}"
								FontSize="11"
								Style="{StaticResource Style.ToolbarIndexText}" />
						<!-- 2. the image.

							The white plate is the background of the Grid rather
							than of a Border, because a Border with no Background
							is not hit-testable and the click on the thumbnail is
							the one gesture this panel exists for.

							The selection ring is drawn INSIDE the image, over it,
							rather than as the Grid's own border: a Border's
							thickness comes out of the box it is given, so making
							it 2px on selection would shrink the thumbnail
							at exactly the moment the user is clicking. The ring
							has a fixed thickness and only its brush changes, so
							the entry never moves.

							Both dimensions are the image's own, from MainWindow.
							SlideThumbnailImageWidth / SlideThumbnailImageHeight:
							the entry width minus the number column, and that
							width over the showing deck's aspect ratio - so the
							picture keeps its shape with the number beside it. The
							fallbacks are this tier's numbers at 16:9. -->
						<Grid x:Name="SlideImageHost" Grid.Column="1"
								Width="{Binding SlideThumbnailImageWidth, FallbackValue=98, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Height="{Binding SlideThumbnailImageHeight, FallbackValue=55, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Background="#FFFFFFFF"
								SnapsToDevicePixels="True">
							<Image x:Name="SlideImage" Stretch="Fill" Source="{Binding BitmapImage}" />
							<Border x:Name="SelectionRing"
								BorderThickness="2" BorderBrush="Transparent" />
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="Tag" Value="False">
							<Setter TargetName="SlideImage" Property="Source" Value="{StaticResource ImageSource.Placeholder}" />
						</Trigger>
						<!-- Not the current slide: no border at all. The ring is
								always present and always the same width - only its
								colour changes. -->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
							<Setter TargetName="IndexText" Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
						</Trigger>
						<!-- the right panel: the number column moves to the image's
								right side -->
						<DataTrigger Binding="{Binding IsLeftSide, RelativeSource={RelativeSource AncestorType={x:Type spx:SlideThumbnailPanel}}}" Value="False">
							<Setter TargetName="IndexText" Property="Grid.Column" Value="1" />
							<Setter TargetName="IndexText" Property="HorizontalAlignment" Value="Left" />
							<Setter TargetName="IndexText" Property="Margin" Value="4,0,0,0" />
							<Setter TargetName="SlideImageHost" Property="Grid.Column" Value="0" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Style.ThumbnailItem1440" TargetType="{x:Type ListBoxItem}">
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Tag" Value="{Binding IsPptThumbnail}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ListBoxItem}">
					<!-- Background="Transparent" so the whole entry - thumbnail and
					     number - is clickable, and the entry width bound to
					     MainWindow.SlideThumbnailWidth; see the note in
					     Style.ThumbnailItem0 for both, and for why the divider that
					     used to sit between the number and the image is no longer
					     drawn. -->
					<Grid Background="Transparent" Margin="0,0,0,14"
						Width="{Binding SlideThumbnailWidth, FallbackValue=190, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<Grid.ColumnDefinitions>
							<!-- the number's own column, fixed so the images line
								up down the list whatever digits each entry
								carries -->
							<ColumnDefinition Width="{Binding SlideThumbnailNumberColumn, FallbackValue=30, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<!-- 1. the number: plain grey, and the theme accent for
								the slide that is showing.

							It stands BESIDE the image now, on the panel's outer
							side - left of the image on the left panel; the right
							panel's trigger below moves it to the other column
							and flips its alignment with it. -->
						<TextBlock x:Name="IndexText" Grid.Column="0"
								Margin="0,0,5,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Text="{Binding Index}"
								FontSize="14"
								Style="{StaticResource Style.ToolbarIndexText}" />
						<!-- 2. the image.

							The white plate is the background of the Grid rather
							than of a Border, because a Border with no Background
							is not hit-testable and the click on the thumbnail is
							the one gesture this panel exists for.

							The selection ring is drawn INSIDE the image, over it,
							rather than as the Grid's own border: a Border's
							thickness comes out of the box it is given, so making
							it 2px on selection would shrink the thumbnail
							at exactly the moment the user is clicking. The ring
							has a fixed thickness and only its brush changes, so
							the entry never moves.

							Both dimensions are the image's own, from MainWindow.
							SlideThumbnailImageWidth / SlideThumbnailImageHeight:
							the entry width minus the number column, and that
							width over the showing deck's aspect ratio - so the
							picture keeps its shape with the number beside it. The
							fallbacks are this tier's numbers at 16:9. -->
						<Grid x:Name="SlideImageHost" Grid.Column="1"
								Width="{Binding SlideThumbnailImageWidth, FallbackValue=160, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Height="{Binding SlideThumbnailImageHeight, FallbackValue=90, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Background="#FFFFFFFF"
								SnapsToDevicePixels="True">
							<Image x:Name="SlideImage" Stretch="Fill" Source="{Binding BitmapImage}" />
							<Border x:Name="SelectionRing"
								BorderThickness="2" BorderBrush="Transparent" />
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="Tag" Value="False">
							<Setter TargetName="SlideImage" Property="Source" Value="{StaticResource ImageSource.Placeholder}" />
						</Trigger>
						<!-- Not the current slide: no border at all. The ring is
								always present and always the same width - only its
								colour changes. -->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
							<Setter TargetName="IndexText" Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
						</Trigger>
						<!-- the right panel: the number column moves to the image's
								right side -->
						<DataTrigger Binding="{Binding IsLeftSide, RelativeSource={RelativeSource AncestorType={x:Type spx:SlideThumbnailPanel}}}" Value="False">
							<Setter TargetName="IndexText" Property="Grid.Column" Value="1" />
							<Setter TargetName="IndexText" Property="HorizontalAlignment" Value="Left" />
							<Setter TargetName="IndexText" Property="Margin" Value="5,0,0,0" />
							<Setter TargetName="SlideImageHost" Property="Grid.Column" Value="0" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Style.ThumbnailItem3800" TargetType="{x:Type ListBoxItem}">
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Tag" Value="{Binding IsPptThumbnail}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ListBoxItem}">
					<!-- Background="Transparent" so the whole entry is clickable, and the entry
					     width bound to MainWindow.SlideThumbnailWidth; see the note in
					     Style.ThumbnailItem0, along with why the divider under the
					     number is no longer drawn. -->
					<Grid Background="Transparent" Margin="0,0,0,26"
						Width="{Binding SlideThumbnailWidth, FallbackValue=330, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
						<Grid.ColumnDefinitions>
							<!-- the number's own column, fixed so the images line
								up down the list whatever digits each entry
								carries -->
							<ColumnDefinition Width="{Binding SlideThumbnailNumberColumn, FallbackValue=50, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<!-- 1. the number: plain grey, and the theme accent for
								the slide that is showing.

							It stands BESIDE the image now, on the panel's outer
							side - left of the image on the left panel; the right
							panel's trigger below moves it to the other column
							and flips its alignment with it. -->
						<TextBlock x:Name="IndexText" Grid.Column="0"
								Margin="0,0,10,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Text="{Binding Index}"
								FontSize="24"
								Style="{StaticResource Style.ToolbarIndexText}" />
						<!-- 2. the image.

							The white plate is the background of the Grid rather
							than of a Border, because a Border with no Background
							is not hit-testable and the click on the thumbnail is
							the one gesture this panel exists for.

							The selection ring is drawn INSIDE the image, over it,
							rather than as the Grid's own border: a Border's
							thickness comes out of the box it is given, so making
							it 6px on selection would shrink the thumbnail
							at exactly the moment the user is clicking. The ring
							has a fixed thickness and only its brush changes, so
							the entry never moves.

							Both dimensions are the image's own, from MainWindow.
							SlideThumbnailImageWidth / SlideThumbnailImageHeight:
							the entry width minus the number column, and that
							width over the showing deck's aspect ratio - so the
							picture keeps its shape with the number beside it. The
							fallbacks are this tier's numbers at 16:9. -->
						<Grid x:Name="SlideImageHost" Grid.Column="1"
								Width="{Binding SlideThumbnailImageWidth, FallbackValue=280, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Height="{Binding SlideThumbnailImageHeight, FallbackValue=158, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								Background="#FFFFFFFF"
								SnapsToDevicePixels="True">
							<Image x:Name="SlideImage" Stretch="Fill" Source="{Binding BitmapImage}" />
							<Border x:Name="SelectionRing"
								BorderThickness="6" BorderBrush="Transparent" />
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="Tag" Value="False">
							<Setter TargetName="SlideImage" Property="Source" Value="{StaticResource ImageSource.Placeholder}" />
						</Trigger>
						<!-- Not the current slide: no border at all. The ring is
								always present and always the same width - only its
								colour changes. -->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
							<Setter TargetName="IndexText" Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
						</Trigger>
						<!-- the right panel: the number column moves to the image's
								right side -->
						<DataTrigger Binding="{Binding IsLeftSide, RelativeSource={RelativeSource AncestorType={x:Type spx:SlideThumbnailPanel}}}" Value="False">
							<Setter TargetName="IndexText" Property="Grid.Column" Value="1" />
							<Setter TargetName="IndexText" Property="HorizontalAlignment" Value="Left" />
							<Setter TargetName="IndexText" Property="Margin" Value="10,0,0,0" />
							<Setter TargetName="SlideImageHost" Property="Grid.Column" Value="0" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- The list itself: no ModernWpf chrome (its default brings a border and rounded
	     corners), fully transparent, the Rectangle behind it is the backdrop. -->
	<Style x:Key="Style.ThumbnailListBase" TargetType="{x:Type ListBox}">
		<Setter Property="SelectionMode" Value="Single" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ScrollViewer.CanContentScroll" Value="False" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<!-- The scrollbar is SHOWN, not hidden: a deck of thirty slides gives no
		     other indication that there is anything below the fold, and on a touch
		     panel a hidden one is invisible as well as unreachable.

		     Visible rather than Auto on purpose. Auto makes the scrollbar come and go
		     with the length of the deck, and every appearance takes its width out of
		     the list - which is the width the entries are sized to, so the entries
		     would resize every time a slide arrived. Visible keeps it there and the
		     entries steady.

		     The entries are sized from what the panel really leaves over once the
		     list's padding and the scrollbar have had their share of it
		     (SlideThumbnailPanel.ContentWidth), which is what keeps the scrollbar
		     from landing on the right edge of an entry. -->
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />

		<!--
		  ItemsSource is NOT set here on purpose.

		  This setter used to read <Setter Property="ItemsSource" Value="{Binding IsAsync=True}" />,
		  which is a binding with no Path at all: it takes the literal string
		  "IsAsync=True" as a property path. It fails silently, ItemsSource stayed
		  null, and SlideListBox.Items.Count was therefore always 0 - which is what
		  made the thumbnail button do nothing, because all four Thumbnail_Click
		  handlers bail out on "count <= 0".

		  It cannot simply be {Binding SlideItems} either: MainWindow never sets
		  its own DataContext, so that path has nothing to resolve against. The
		  real binding lives on the ListBox element in SlideThumbnailPanel.xaml,
		  which reaches the owning MainWindow through RelativeSource.
		-->
	</Style>

	<Style x:Key="Style.ThumbnailList0" BasedOn="{StaticResource Style.ThumbnailListBase}" TargetType="{x:Type ListBox}">
		<Setter Property="ItemContainerStyle" Value="{DynamicResource Style.ThumbnailItem0}" />
	</Style>
	<Style x:Key="Style.ThumbnailList1440" BasedOn="{StaticResource Style.ThumbnailListBase}" TargetType="{x:Type ListBox}">
		<Setter Property="ItemContainerStyle" Value="{DynamicResource Style.ThumbnailItem1440}" />
	</Style>
	<Style x:Key="Style.ThumbnailList3800" BasedOn="{StaticResource Style.ThumbnailListBase}" TargetType="{x:Type ListBox}">
		<Setter Property="ItemContainerStyle" Value="{DynamicResource Style.ThumbnailItem3800}" />
	</Style>

</ResourceDictionary>
